      "path_regex": "^papers/【索引】papers\\.md$"
    },
    {
      "kind": "domain",
      "path_regex": "^papers/【索引】[^/]+\\.md$"
    },
    {
      "kind": "partition",
      "path_regex": "^papers/_unfiled/【索引】[^/]+\\.md$"
    },
    {
      "kind": "direction",
      "path_regex": "^papers/[^/]+/【索引】[^/]+\\.md$"
    },
    {
      "kind": "paper",
      "path_regex": "^papers/[^/]+/【\\d{4}】[^/]+/【\\d{4}】[^/]+\\.md$"
    },
    {
      "kind": "topic_library",
